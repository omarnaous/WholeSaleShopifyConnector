{
  "name": "@lumen/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply lumen --local",
    "db:migrate:remote": "wrangler d1 migrations apply lumen --remote",
    "db:seed:local": "tsx scripts/seed.ts > .wrangler/seed.sql && wrangler d1 execute lumen --local --file .wrangler/seed.sql",
    "db:seed:remote": "tsx scripts/seed.ts > .wrangler/seed.sql && wrangler d1 execute lumen --remote --file .wrangler/seed.sql",
    "images:upload:local": "tsx scripts/upload-images.ts --local",
    "images:upload:remote": "tsx scripts/upload-images.ts --remote"
  },
  "dependencies": {
    "@lumen/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
}
